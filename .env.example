# CivicSarthi Environment Configuration Template
# Server configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Frontend configuration
VITE_API_URL=http://localhost:5000

# Authentication & Session Security (Phase 3)
# In production, generate a secure random 256-bit secret (e.g. openssl rand -hex 32)
JWT_SECRET=civicsarthi_dev_insecure_jwt_secret_change_in_production
JWT_EXPIRES_IN=24h

# Persistence backend (json | mongodb | auto)
PERSISTENCE_MODE=json
# MONGODB_URI=mongodb://localhost:27017/civicsarthi

# SLA Governance Configuration (days)
SLA_RESOLUTION_DEADLINE_DAYS=30
SLA_STALE_UPDATE_DAYS=7
SLA_REASSIGNMENT_LOOP_THRESHOLD=3
