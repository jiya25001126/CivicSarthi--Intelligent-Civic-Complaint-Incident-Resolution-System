# =====================================================================
# CivicSarthi — Environment Configuration Template (Production Readiness)
# Tagline: From Complaint to Resolution
# =====================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=development
# Set TRUST_PROXY=true or TRUST_PROXY=1 when deployed behind reverse proxy (Nginx, ALB, Cloudflare, Docker Gateway)
TRUST_PROXY=false
# Allowed frontend origin(s). In production, specify full FQDN or comma-separated origins:
# FRONTEND_ORIGIN=https://civicsarthi.gov.in,https://admin.civicsarthi.gov.in
FRONTEND_ORIGIN=http://localhost:5173

# Frontend Client Configuration
VITE_API_URL=http://localhost:5000

# Authentication & Session Security (Phase 3 & Phase 14)
# In production, JWT_SECRET MUST be configured with at least 16 characters (e.g., openssl rand -hex 32)
# The server will intentionally fail to start if NODE_ENV=production and JWT_SECRET is unset or insecure.
JWT_SECRET=civicsarthi_dev_insecure_jwt_secret_change_in_production
JWT_EXPIRES_IN=24h

# Persistence Backend (json | mongodb)
PERSISTENCE_MODE=json
# MONGODB_URI=mongodb://localhost:27017/civicsarthi

# Rate Limiting & Denial-of-Service Defenses (Per 15-Minute Window)
AUTH_RATE_LIMIT_MAX=15
TRACKING_RATE_LIMIT_MAX=60
SUBMISSION_RATE_LIMIT_MAX=30

# Statutory SLA Governance Configuration (Calendar Days)
SLA_RESOLUTION_DEADLINE_DAYS=30
SLA_STALE_UPDATE_DAYS=7
SLA_REASSIGNMENT_LOOP_THRESHOLD=3

# Citizen Follow-Up Reminders Cooldown (Hours)
REMINDER_COOLDOWN_HOURS=24

