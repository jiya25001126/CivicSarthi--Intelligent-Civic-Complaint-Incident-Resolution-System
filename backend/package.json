{
  "name": "civicsarthi-backend",
  "version": "1.1.0",
  "description": "Backend API layer for CivicSarthi — Intelligent Civic Complaint & Incident Resolution System",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:reset": "node src/scripts/seed.js --reset",
    "seed:demo": "node src/scripts/seed-demo-data.js",
    "init:demo": "node src/scripts/init-demo-accounts.js",
    "provision:user": "node src/scripts/provision-user.js",
    "migrate:mongo": "node src/scripts/migrate.js",
    "seed:mongo:demo": "node src/scripts/seed-mongo-demo-complaints.js",
    "test": "node --test tests/*.test.js tests/**/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
